{
  "name": "@jvavscratch/generator",
  "version": "1.0.0",
  "description": "Code generators for jvavscratch: one per Babel AST node, registered into core's dispatch table on import",
  "license": "MPL-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./optimise": {
      "types": "./dist/optimise/index.d.ts",
      "require": "./dist/optimise/index.js",
      "import": "./dist/optimise/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "prepare": "tsc"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/types": "^7.23.6",
    "@jvavscratch/core": "github:Jvavscratch/core",
    "@jvavscratch/types": "github:Jvavscratch/types",
    "@jvavscratch/utils": "github:Jvavscratch/utils"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
